function LoaderLib:AddSearchList()
    local parent = self.Page
    
    local SearchFrame = Instance.new("Frame")
    SearchFrame.Size = UDim2.new(1, 0, 0, 40)
    SearchFrame.BackgroundTransparency = 1
    SearchFrame.ZIndex = parent.ZIndex
    SearchFrame.Parent = parent

    local SearchBg = applySquircle(SearchFrame, Color3.fromRGB(40, 40, 45), 0.03906)

    local SearchBox = Instance.new("TextBox")
    SearchBox.Size = UDim2.new(1, -20, 1, 0)
    SearchBox.Position = UDim2.new(0, 10, 0, 0)
    SearchBox.BackgroundTransparency = 1
    SearchBox.Text = ""
    SearchBox.PlaceholderText = "Search..."
    SearchBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    SearchBox.PlaceholderColor3 = Color3.fromRGB(150, 150, 150)
    SearchBox.FontFace = Font.new("rbxassetid://12187365364", Enum.FontWeight.Medium)
    SearchBox.TextSize = 14
    SearchBox.TextXAlignment = Enum.TextXAlignment.Left
    SearchBox.ZIndex = parent.ZIndex + 1
    SearchBox.Parent = SearchFrame

    local Scroll = Instance.new("ScrollingFrame")
    Scroll.Size = UDim2.new(1, 0, 1, -50)
    Scroll.Position = UDim2.new(0, 0, 0, 50)
    Scroll.BackgroundTransparency = 1
    Scroll.ScrollBarThickness = 2
    Scroll.ZIndex = parent.ZIndex
    Scroll.Parent = parent

    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 10)
    Layout.SortOrder = Enum.SortOrder.LayoutOrder
    Layout.Parent = Scroll

    local SearchObj = {
        Scroll = Scroll,
        Box = SearchBox,
        Items = {}
    }

    function SearchObj:AddItem(name, id)
        table.insert(self.Items, {Name = name, Id = id})
        self:Refresh()
    end

    function SearchObj:Refresh()
        for _, child in pairs(self.Scroll:GetChildren()) do
            if child:IsA("TextButton") or child:IsA("Frame") then child:Destroy() end
        end
        
        local filter = string.lower(self.Box.Text)
        for _, itemData in ipairs(self.Items) do
            if filter == "" or string.find(string.lower(itemData.Name), filter) then
                local btnContainer = Instance.new("Frame")
                btnContainer.Size = UDim2.new(1, -5, 0, 42)
                btnContainer.BackgroundTransparency = 1
                btnContainer.ZIndex = self.Scroll.ZIndex
                btnContainer.Parent = self.Scroll
                
                local btn, hl, txt = createButtonElement(btnContainer, itemData.Name, UDim2.new(1, 0, 1, 0))
                txt.TextXAlignment = Enum.TextXAlignment.Left
                txt.Position = UDim2.new(0, 15, 0, 0)
                
                local actionBtn, actionHl, actionTxt = createButtonElement(btn, "Join", UDim2.new(0, 60, 0, 26))
                actionBtn.Position = UDim2.new(1, -70, 0.5, -13)
                
                actionBtn.MouseButton1Click:Connect(function()
                    TeleportService:Teleport(itemData.Id, Players.LocalPlayer)
                end)
            end
        end
    end

    SearchBox.Changed:Connect(function(prop)
        if prop == "Text" then
            SearchObj:Refresh()
        end
    end)
    
    return SearchObj
end

function LoaderLib:AddUpdateLog(updates)
    local parent = self.Page
    
    local ULogPanel = Instance.new("Frame")
    ULogPanel.Size = UDim2.new(1, 0, 1, 0)
    ULogPanel.BackgroundTransparency = 1
    ULogPanel.ZIndex = parent.ZIndex
    ULogPanel.Parent = parent

    local ULogBg = applySquircle(ULogPanel, Color3.fromRGB(40, 40, 45), 0.03906)

    local ULogTitle = createText(ULogPanel, "Update Log", UDim2.new(1, 0, 0, 25), nil, Enum.FontWeight.SemiBold)
    ULogTitle.Position = UDim2.new(0, 10, 0, 5)
    ULogTitle.TextSize = 13
    ULogTitle.TextXAlignment = Enum.TextXAlignment.Left

    local updateString = ""
    for _, str in pairs(updates) do
        updateString = updateString .. "- " .. str .. "\n"
    end

    local ULogText = createText(ULogPanel, updateString, UDim2.new(1, -20, 1, -35), nil, Enum.FontWeight.Medium, Color3.fromRGB(180, 180, 180))
    ULogText.Position = UDim2.new(0, 10, 0, 30)
    ULogText.TextSize = 12
    ULogText.TextXAlignment = Enum.TextXAlignment.Left
    ULogText.TextYAlignment = Enum.TextYAlignment.Top
    
    return ULogPanel
end

