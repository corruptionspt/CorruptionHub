-- UI Asset Helpers
local function applySquircle(parent, color, sliceScale, transparency)
    local img = Instance.new("ImageLabel")
    img.Name = "Squircle"
    img.BackgroundTransparency = 1
    img.Size = UDim2.new(1, 0, 1, 0)
    img.Image = "rbxassetid://80999662900595"
    img.ImageColor3 = color
    img.ImageTransparency = transparency or 0
    img.ScaleType = Enum.ScaleType.Slice
    img.SliceCenter = Rect.new(256, 256, 256, 256)
    img.SliceScale = sliceScale or 0.08594
    img.ZIndex = parent.ZIndex
    img.Parent = parent
    return img
end

local function applyShadow(parent)
    local img = Instance.new("ImageLabel")
    img.Name = "Shadow"
    img.BackgroundTransparency = 1
    img.Size = UDim2.new(1, 3, 1, 3)
    img.Position = UDim2.new(0.5, 0, 0.5, 0)
    img.AnchorPoint = Vector2.new(0.5, 0.5)
    img.Image = "rbxassetid://84825982946844"
    img.ImageColor3 = Color3.fromRGB(0, 0, 0)
    img.ImageTransparency = 0.5
    img.ScaleType = Enum.ScaleType.Slice
    img.SliceCenter = Rect.new(512, 512, 512, 512)
    img.SliceScale = 0.01953
    img.ZIndex = parent.ZIndex - 1
    img.Parent = parent
    return img
end

local function createText(parent, text, size, font, weight, color)
    local txt = Instance.new("TextLabel")
    txt.Size = size
    txt.BackgroundTransparency = 1
    txt.Text = text
    txt.TextColor3 = color or Color3.fromRGB(255, 255, 255)
    txt.FontFace = Font.new("rbxassetid://12187365364", weight or Enum.FontWeight.Medium)
    txt.TextSize = 14
    txt.ZIndex = parent.ZIndex + 1
    txt.Parent = parent
    return txt
end

-- Core Window Creation
function LoaderLib:CreateWindow(options)
    options = options or {}
    local TitleText = options.Title or "Loader"
    local Size = options.Size or UDim2.new(0, 500, 0, 350)
    
    local selfObj = setmetatable({}, LoaderLib)
    
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "CustomLoaderLib"
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.ScreenInsets = Enum.ScreenInsets.None
    ScreenGui.ResetOnSpawn = false
    ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local targetGui
    if gethui then
        pcall(function() targetGui = gethui() end)
    end
    if not targetGui then
        pcall(function() targetGui = game:GetService("CoreGui") end)
    end
    if not targetGui and Players.LocalPlayer then
        targetGui = Players.LocalPlayer:FindFirstChild("PlayerGui")
    end
    if targetGui then
        ScreenGui.Parent = targetGui
    end
    selfObj.ScreenGui = ScreenGui

    local MainContainer = Instance.new("Frame")
    MainContainer.Name = "MainContainer"
    MainContainer.Size = Size
    MainContainer.Position = UDim2.new(0.5, 0, 0.5, 0)
    MainContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    MainContainer.BackgroundTransparency = 1
    MainContainer.Parent = ScreenGui

    local MainBg = applySquircle(MainContainer, Color3.fromRGB(25, 25, 28), 0.08594)
    MainBg.ZIndex = 1

    local TopBar = Instance.new("Frame")
    TopBar.Size = UDim2.new(1, 0, 0, 45)
    TopBar.BackgroundTransparency = 1
    TopBar.ZIndex = 2
    TopBar.Parent = MainContainer

    local TopTitle = createText(TopBar, TitleText, UDim2.new(1, -20, 1, 0), nil, Enum.FontWeight.SemiBold)
    TopTitle.TextSize = 20
    TopTitle.Position = UDim2.new(0, 20, 0, 0)
    TopTitle.TextXAlignment = Enum.TextXAlignment.Left

    -- Dragging Logic
    local dragging, dragInput, dragStart, startPos
    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainContainer.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainContainer.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local ContentArea = Instance.new("Frame")
    ContentArea.Size = UDim2.new(1, -40, 1, -65)
    ContentArea.Position = UDim2.new(0, 20, 0, 45)
    ContentArea.BackgroundTransparency = 1
    ContentArea.ZIndex = 2
    ContentArea.Parent = MainContainer

    local TabButtonsFrame = Instance.new("Frame")
    TabButtonsFrame.Size = UDim2.new(0, 120, 1, 0)
    TabButtonsFrame.BackgroundTransparency = 1
    TabButtonsFrame.ZIndex = 2
    TabButtonsFrame.Parent = ContentArea

    local TabListLayout = Instance.new("UIListLayout")
    TabListLayout.Padding = UDim.new(0, 10)
    TabListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    TabListLayout.Parent = TabButtonsFrame

    local PagesFrame = Instance.new("Frame")
    PagesFrame.Size = UDim2.new(1, -135, 1, 0)
    PagesFrame.Position = UDim2.new(0, 135, 0, 0)
    PagesFrame.BackgroundTransparency = 1
    PagesFrame.ZIndex = 2
    PagesFrame.Parent = ContentArea

    selfObj.TabButtonsFrame = TabButtonsFrame
    selfObj.PagesFrame = PagesFrame
    selfObj.Tabs = {}
    selfObj.ActiveTab = nil

    return selfObj
end

-- Component Functions
local function createButtonElement(parent, text, size)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.BackgroundTransparency = 1
    btn.Text = ""
    btn.ZIndex = parent.ZIndex
    btn.Parent = parent
    
    local shadow = applyShadow(btn)
    local bg = applySquircle(btn, Color3.fromRGB(83, 83, 92), 0.03906)
    local highlight = applySquircle(btn, Color3.fromRGB(255, 255, 255), 0.03906, 0.95)
    
    local txt = createText(btn, text, UDim2.new(1, 0, 1, 0), nil, Enum.FontWeight.Medium)
    txt.TextSize = 14
    
    return btn, highlight, txt
end

function LoaderLib:CreateTab(name)
    local TabObj = {}
    
    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ZIndex = 2
    page.Parent = self.PagesFrame
    
    local btn, highlight, txt = createButtonElement(self.TabButtonsFrame, name, UDim2.new(1, 0, 0, 38))
    
    if not self.ActiveTab then
        self.ActiveTab = highlight
        highlight.ImageTransparency = 0.85
        page.Visible = true
    end
    
    btn.MouseButton1Click:Connect(function()
        if self.ActiveTab then
            TweenService:Create(self.ActiveTab, TweenInfo.new(0.2), {ImageTransparency = 0.95}):Play()
        end
        self.ActiveTab = highlight
        TweenService:Create(highlight, TweenInfo.new(0.2), {ImageTransparency = 0.85}):Play()
        
        for _, p in pairs(self.PagesFrame:GetChildren()) do
            if p:IsA("Frame") then p.Visible = false end
        end
        page.Visible = true
    end)
    
    TabObj.Page = page
    TabObj.Library = self
    setmetatable(TabObj, {__index = LoaderLib})
    return TabObj
end

function LoaderLib:AddButton(options)
    local parent = self.Page
    local title = options.Title or "Button"
    local callback = options.Callback or function() end
    
    local btnContainer = Instance.new("Frame")
    btnContainer.Size = UDim2.new(1, 0, 0, 42)
    btnContainer.BackgroundTransparency = 1
    btnContainer.ZIndex = parent.ZIndex
    btnContainer.Parent = parent
    
    local btn, hl, txt = createButtonElement(btnContainer, title, UDim2.new(1, 0, 1, 0))
    txt.TextXAlignment = Enum.TextXAlignment.Center
    
    btn.MouseButton1Click:Connect(callback)
    return btn
end

